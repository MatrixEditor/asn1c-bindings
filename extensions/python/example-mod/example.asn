ExampleModule DEFINITIONS AUTOMATIC TAGS  ::= BEGIN

-- basic types

Signed8 ::= INTEGER (-127..127)

NamedSigned8 ::= INTEGER {
    first(-1),
    second(0),
    third(1)
}

ExampleBoolean ::= BOOLEAN
ExampleBitString ::= BIT STRING
ExampleOctetString ::= OCTET STRING (SIZE(1..32))
ExampleNull ::= NULL
ExampleObjectIdentifier ::= OBJECT IDENTIFIER
ExampleRelativeOid ::= RELATIVE-OID
ExampleReal ::= REAL

ExampleChoice ::= CHOICE {
    foo         OCTET STRING,
    bar         INTEGER,
    baz         NamedSigned8
}

END