TestEncodingControl DEFINITIONS AUTOMATIC TAGS ::= BEGIN

TestMessage ::= SEQUENCE {
    data  OCTET STRING
}

ENCODING-CONTROL XER
-- Body content will be parsed in Phase 4

END
